{
  "name": "chokro-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @chokro/db db:push",
    "db:migrate": "pnpm --filter @chokro/db db:migrate",
    "db:seed": "pnpm --filter @chokro/db db:seed",
    "db:setup": "pnpm run db:push && pnpm run db:migrate && pnpm run db:seed",
    "expo:doctor": "pnpm --filter @chokro/mobile run doctor",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "affected:test": "nx affected -t test",
    "graph": "nx graph"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.18.0",
  "onlyBuiltDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "nx": "23.1.1",
    "turbo": "^2.10.8",
    "typescript": "~6.0.3"
  }
}