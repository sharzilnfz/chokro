{
  "name": "chokro-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @chokro/db db:push",
    "db:migrate": "pnpm --filter @chokro/db db:migrate",
    "db:seed": "pnpm --filter @chokro/db db:seed",
    "db:setup": "pnpm db:push && pnpm db:migrate && pnpm db:seed",
    "expo:doctor": "pnpm --filter @chokro/mobile run doctor"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.18.0",
  "onlyBuiltDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.10.8",
    "typescript": "~6.0.3"
  }
}
