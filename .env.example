# Local PostgreSQL database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chokro

# Replace with long random values outside local development.
JWT_SECRET=replace-with-a-long-random-jwt-secret
QR_SECRET=replace-with-a-long-random-qr-secret

# Use your computer's LAN URL when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:3000

# ---- Email notifications (optional; container scheduler reads these) ----
# NOTIFY_TRANSPORT: json (prints email, no SMTP) | smtp (real) | ethereal (preview)
NOTIFY_TRANSPORT=json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail App Password (16-char), NOT your normal password.
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
# Daily cron time; listings older than this many hours are not "new"
NOTIFY_CRON=12 14 * * *
NOTIFY_WINDOW_HOURS=24
APP_URL=http://localhost:3000
# Mobile app URL scheme used for "open in app" links in the email
APP_SCHEME=chokro
