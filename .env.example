# Local PostgreSQL database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chokro

# Replace with long random values outside local development.
JWT_SECRET=replace-with-a-long-random-jwt-secret
QR_SECRET=replace-with-a-long-random-qr-secret

# Use your computer's LAN URL when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Optional integrations (the app falls back gracefully when these are unset) ---

# metals-api.com access key for live commodity benchmark prices.
# When unset, the benchmark service uses its calibrated baseline fallback table.
COMMODITY_API_KEY=

# OpenAI API key for AI valuation (F2 vision classification).
# When unset, the valuation service uses its heuristic classifier fallback.
OPENAI_API_KEY=

# Mapbox access token for live driving routes in geo-dispatch (F3).
# When unset, the dispatch service falls back to deterministic
# haversine nearest-neighbour routing with fixed average speed ETAs.
MAPBOX_TOKEN=
