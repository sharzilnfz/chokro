# Local PostgreSQL database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chokro

# Replace with long random values outside local development.
JWT_SECRET=replace-with-a-long-random-jwt-secret
QR_SECRET=replace-with-a-long-random-qr-secret

# Use your computer's LAN URL when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Optional integrations (the app falls back gracefully when these are unset) ---

# Commodity benchmark & live FX rates (100% free open exchange feed, no API key required).
# When offline, the benchmark service uses its calibrated baseline fallback table.

# AI Vision for valuation (F2 vision classification).
# Google Gemini API key (100% Free at https://aistudio.google.com) OR OpenAI API key.
# When unset, the valuation service uses its built-in heuristic classifier fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mapbox access token for live driving routes in geo-dispatch (F3).
# When unset, the dispatch service automatically uses 100% free OSRM (OpenStreetMap)
# routing, with deterministic Haversine nearest-neighbour as offline fallback.
MAPBOX_TOKEN=

# Pusher Channels for live auction bid push (F4). Optional — when the server
# keys are unset the API skips realtime push and mobile clients rely on the
# built-in 4-second polling fallback; the demo runs fully keyless.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=
