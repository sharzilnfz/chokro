{
  "info": {
    "_postman_id": "chokro-m3-valuation-vision-api",
    "name": "Chokro API - Member 3 (Sharzil Nafis) Assignment 03",
    "description": "REST APIs for Feature 1 (Market-Benchmarked Valuation Engine) and Feature 2 (AI Next-Life Scrap Vision Agent) for Chokro Circular Economy Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1475",
      "type": "string",
      "description": "Base URL of backend server running on student ID port 1475"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "Bearer JWT token returned from login/signup"
    },
    {
      "key": "scanId",
      "value": "",
      "type": "string",
      "description": "ID of created valuation scan"
    }
  ],
  "item": [
    {
      "name": "Feature 1: Market-Benchmarked Valuation & Rate Card Engine",
      "description": "Feature F1: Real-time scrap item valuation, effective-dated rate cards, and global commodity benchmark drift analysis.",
      "item": [
        {
          "name": "1. Estimate Item Valuation & Market Drift",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-card/estimate?category=PLASTICS&condition=GOOD&weight=15.5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rate-card", "estimate"],
              "query": [
                { "key": "category", "value": "PLASTICS", "description": "Material category (e.g. PLASTICS, METAL, PAPER, GLASS, CLOTHES, BOOKS, FURNITURE, APPLIANCES, E_WASTE)" },
                { "key": "condition", "value": "GOOD", "description": "Item condition (EXCELLENT, GOOD, FAIR, POOR)" },
                { "key": "weight", "value": "15.5", "description": "Weight in kg (for weight categories)" }
              ]
            },
            "description": "Calculates estimated payout in BDT, joins with current effective rate card, and compares against global commodity index."
          },
          "response": []
        },
        {
          "name": "2. Get Published Rates with Commodity Drift",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-card/published",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rate-card", "published"]
            },
            "description": "Fetches all currently active rate card prices enriched with market benchmark price and drift status."
          },
          "response": []
        },
        {
          "name": "3. Sync Commodity Market Benchmarks",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fx_rate\": 122.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-card/benchmarks/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rate-card", "benchmarks", "sync"]
            },
            "description": "Fetches commodity prices from external API / scrap market feed, converts with USD/BDT FX rate, and updates rate_benchmarks table."
          },
          "response": []
        },
        {
          "name": "4. Get All Commodity Benchmarks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-card/benchmarks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "rate-card", "benchmarks"]
            },
            "description": "Retrieves the full list of tracked global commodity benchmarks stored in the database."
          },
          "response": []
        },
        {
          "name": "5. Admin Create Rate Card Entry (Effective-Dated Versioning)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"METAL\",\n  \"conditionBand\": \"GOOD\",\n  \"priceBdt\": 120.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/rate-card",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "rate-card"]
            },
            "description": "Creates an admin-managed baseline rate with timestamp versioning so past valuations remain historical and reproducible."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feature 2: AI Next-Life Scrap Vision Agent",
      "description": "Feature F2: Multimodal image classification, domain safety invariant enforcement, next-life recommendation (REUSE/DONATE/REPAIR/RESELL/RECYCLE), and DB rate valuation.",
      "item": [
        {
          "name": "1. Classify Item & Estimate Value (Clean Material)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.scan_id) {",
                  "    pm.collectionVariables.set('scanId', jsonData.data.scan_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promptNotes\": \"discarded plastic bottles, beverage containers, and HDPE jugs in good condition\",\n  \"categoryHint\": \"PLASTICS\",\n  \"conditionHint\": \"GOOD\",\n  \"declaredQuantity\": 12.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/valuation/classify-and-estimate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "valuation", "classify-and-estimate"]
            },
            "description": "Accepts scrap photo or contextual description, runs vision classification, prices with DB rate card, and produces next-life path rationale."
          },
          "response": []
        },
        {
          "name": "2. Classify E-Waste (Enforces Strict Safety RECYCLE Invariant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promptNotes\": \"old cracked smartphone motherboard and lithium-ion battery\",\n  \"categoryHint\": \"E_WASTE\",\n  \"declaredQuantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/valuation/classify-and-estimate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "valuation", "classify-and-estimate"]
            },
            "description": "Tests the safety invariant: E-waste/hazardous items are strictly forced to RECYCLE path and unit piece, regardless of condition."
          },
          "response": []
        },
        {
          "name": "3. Classify Appliance (Enforces Resell/Repair Path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promptNotes\": \"used microwave oven, heating element works fine with minor cosmetic scratch\",\n  \"categoryHint\": \"APPLIANCES\",\n  \"conditionHint\": \"GOOD\",\n  \"declaredQuantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/valuation/classify-and-estimate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "valuation", "classify-and-estimate"]
            },
            "description": "Demonstrates reasoned next-life recommendation (RESELL path) when residual utility is high."
          },
          "response": []
        },
        {
          "name": "4. List Recent Valuation Scans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/valuation/scans?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "valuation", "scans"],
              "query": [
                { "key": "limit", "value": "10", "description": "Number of scan records to return" }
              ]
            },
            "description": "Retrieves the audit log of recent AI valuation scans stored in valuation_scans table."
          },
          "response": []
        },
        {
          "name": "5. Get Single Valuation Scan Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/valuation/scans/{{scanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "valuation", "scans", "{{scanId}}"]
            },
            "description": "Fetches a specific valuation scan by its UUID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth & Scaffolding (For Token Generation)",
      "description": "Helper endpoints to register and obtain Bearer JWT tokens for testing admin and authenticated user routes.",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@chokro.org\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in with seeded admin credentials and automatically saves the Bearer token in {{authToken}} variable."
          },
          "response": []
        },
        {
          "name": "Register New Individual User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student.sharzil@chokro.org\",\n  \"password\": \"password123\",\n  \"role\": \"INDIVIDUAL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Registers a new user and sets the auth token."
          },
          "response": []
        }
      ]
    }
  ]
}
